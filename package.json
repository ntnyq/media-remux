{
  "name": "media-remux",
  "version": "0.0.0",
  "description": "Disk-backed media remuxing, track combining, and segment concatenation for browsers without re-encoding.",
  "keywords": [
    "audio",
    "browser",
    "flv",
    "fmp4",
    "m4a",
    "media",
    "mediabunny",
    "mp4",
    "opfs",
    "remux",
    "video",
    "web-worker"
  ],
  "homepage": "https://github.com/ntnyq/media-remux#readme",
  "bugs": {
    "url": "https://github.com/ntnyq/media-remux/issues"
  },
  "license": "MIT AND MPL-2.0",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com",
    "url": "https://github.com/ntnyq"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/media-remux.git"
  },
  "files": [
    "dist",
    "src/vendor/mediabunny",
    "THIRD_PARTY_NOTICES.md",
    "docs/performance.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --max-warnings 0",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint typecheck test",
    "release:version": "bumpp",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ntnyq/tsconfig": "^3.1.0",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx}": "oxlint --fix --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
